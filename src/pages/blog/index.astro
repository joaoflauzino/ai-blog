---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={`Artigos | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 760px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2em 1em;
			}
			h1 {
				margin-bottom: 1.5em;
			}
			ul {
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				margin-bottom: 2em;
				padding-bottom: 2em;
				border-bottom: 1px solid rgba(var(--gray), 20%);
			}
			ul li:last-child {
				border-bottom: none;
			}
			ul li a {
				text-decoration: none;
				display: block;
			}
			.title {
				margin: 0 0 0.4em 0;
				color: rgb(var(--black));
				font-size: 1.5rem;
				line-height: 1.3;
				transition: color 0.2s ease;
			}
			.date {
				margin: 0 0 0.6em 0;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			.description {
				margin: 0;
				color: rgb(var(--gray-dark));
				font-size: 1rem;
				line-height: 1.6;
			}
			ul li a:hover .title {
				color: var(--accent);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<h1>Artigos & Publicações</h1>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/blog/${post.id}/`}>
									<h2 class="title">{post.data.title}</h2>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<p class="description">{post.data.description}</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
